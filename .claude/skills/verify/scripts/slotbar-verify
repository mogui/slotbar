#!/bin/bash
# Drives an isolated copy of build/Slotbar.app for verification. Run `slotbar-verify help`.
set -euo pipefail

repo="$(cd "$(dirname "$0")/../../../.." && pwd)"
here="$(cd "$(dirname "$0")" && pwd)"
root=/private/tmp/slotbar-verify  # the real path: pgrep matches it
bundle_id=io.github.mogui.slotbar.verify
current="$root/current"

die() { echo "error: $*" >&2; exit 1; }
run_dir() { [ -L "$current" ] || die "no run; use: slotbar-verify launch"; readlink "$current"; }
app_of() { echo "$1/home/Applications/Slotbar.app"; }
pid_of() { cat "$1/pid" 2>/dev/null || true; }
alive() { local pid; pid="$(pid_of "$1")"; [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }
settings_of() { echo "$1/home/Library/Application Support/Slotbar/settings.json"; }

# Two Slots that load nothing until shown, one Profile, Panel on $edge, no hide on focus loss.
seed() {
  local file="$1" terminal="$2" edge="$3"
  mkdir -p "$(dirname "$file")"
  cat > "$file" <<JSON
{
  "schemaVersion": 1,
  "general": { "panelEdge": "$edge", "hideOnFocusLoss": false, "openAtLogin": false, "showInDock": false,
               "panelDepth": { "horizontal": 0.45, "vertical": 0.7 } },
  "profiles": [ { "id": "11111111-1111-1111-1111-111111111111", "name": "Verify", "color": "#007AFF" } ],
  "slots": [
    { "id": "22222222-2222-2222-2222-222222222221", "url": "https://example.com/", "label": "Example",
      "profileId": "11111111-1111-1111-1111-111111111111", "keepAlive": false, "notifications": false },
    { "id": "22222222-2222-2222-2222-222222222222", "url": "https://example.org/", "label": "Example Org",
      "profileId": "11111111-1111-1111-1111-111111111111", "keepAlive": false, "notifications": false }
  ],
  "terminal": { "enabled": $terminal, "theme": "system", "fontSize": 13, "shellPath": null, "startDirectory": null }
}
JSON
}

start() {
  local run="$1" app since
  app="$(app_of "$run")"
  since="$(date '+%Y-%m-%d %H:%M:%S')"
  [ -f "$run/first-since" ] || echo "$since" > "$run/first-since"
  open -n -g --env "CFFIXED_USER_HOME=$run/home" \
    --stdout "$run/evidence/stdout.log" --stderr "$run/evidence/stderr.log" "$app"
  for _ in $(seq 1 40); do
    local pid
    pid="$(pgrep -f "$app/Contents/MacOS/Slotbar" | head -1 || true)"
    if [ -n "$pid" ]; then
      echo "$pid" > "$run/pid"
      if /usr/bin/log show --start "$since" --predicate "processID == $pid AND eventMessage == \"Launched\"" \
          --info --style compact 2>/dev/null | grep -q Launched; then
        echo "ready pid=$pid run=$run"
        return
      fi
    fi
    sleep 0.5
  done
  die "app did not log \"Launched\" within 20 s; see $run/evidence/stderr.log"
}

stop_app() {
  local run="$1" pid
  pid="$(pid_of "$run")"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
  fi
  rm -f "$run/pid"
}

save_logs() {
  # Every process this run started (launch + relaunches), from the first launch on.
  local run="$1" pids
  pids="$(sed 's/.*/processID == &/' "$run/pids" | paste -sd '|' - | sed 's/|/ OR /g')"
  /usr/bin/log show --start "$(head -1 "$run/first-since")" \
    --predicate "subsystem == \"io.github.mogui.slotbar\" AND ($pids)" \
    --info --debug --style compact > "$run/evidence/app.log" 2>/dev/null || true
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  build)
    "$repo/scripts/build-app.sh" debug ;;

  launch)
    terminal=false; edge=right
    while [ $# -gt 0 ]; do
      case "$1" in
        --terminal) terminal=true ;;
        --edge) edge="$2"; shift ;;
        *) die "unknown option $1" ;;
      esac; shift
    done
    [ -d "$repo/build/Slotbar.app" ] || die "build/Slotbar.app missing; run: slotbar-verify build"
    if [ -L "$current" ] && alive "$(readlink "$current")"; then die "a run is live: $(readlink "$current"); stop it first"; fi
    run="$root/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$run/evidence" "$run/home/Applications"
    app="$(app_of "$run")"
    # Under ~/Applications of the isolated home, so the "Move Slotbar to Applications" alert stays away.
    cp -R "$repo/build/Slotbar.app" "$app"
    /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $bundle_id" "$app/Contents/Info.plist"
    codesign --force --deep -s - "$app" 2>/dev/null
    seed "$(settings_of "$run")" "$terminal" "$edge"
    ln -sfn "$run" "$current"
    git -C "$repo" rev-parse HEAD > "$run/evidence/revision"
    start "$run"
    pid_of "$run" >> "$run/pids" ;;

  relaunch)
    run="$(run_dir)"
    stop_app "$run"
    start "$run"
    pid_of "$run" >> "$run/pids" ;;

  doctor)
    run="$(run_dir)"; pid="$(pid_of "$run")"; app="$(app_of "$run")"
    echo "run:       $run"
    echo "revision:  $(cat "$run/evidence/revision") (worktree HEAD $(git -C "$repo" rev-parse HEAD))"
    echo "bundle id: $(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")"
    if alive "$run"; then echo "process:   $pid $(ps -o comm= -p "$pid")"; else echo "process:   NOT RUNNING"; exit 1; fi
    echo "settings:  $(settings_of "$run")"
    echo "terminal:  $(plutil -extract terminal.enabled raw "$(settings_of "$run")" 2>/dev/null || echo '?')"
    echo "windows:"; swift "$here/windows.swift" "$pid" | sed 's/^/  /'
    echo "shells:    $(pgrep -P "$pid" | wc -l | tr -d ' ')"
    echo "accessibility: $(orca computer get-app-state --app "$bundle_id" --no-screenshot --json 2>/dev/null \
      | grep -q '"permission_denied"' && echo 'DENIED (no clicks or keys; screenshots and process checks only)' || echo ok)" ;;

  show)
    # A second open of the running app is a reopen event: the AppDelegate shows the Panel.
    open -g "$(app_of "$(run_dir)")" ;;

  shot)
    run="$(run_dir)"; name="${1:?usage: slotbar-verify shot <name>}"; pid="$(pid_of "$run")"
    n=0
    while read -r id layer x y w h title; do
      [ "$w" -gt 60 ] && [ "$h" -gt 60 ] || continue   # skip the status item and tooltips
      screencapture -x -o -l"$id" "$run/evidence/$name-$id.png"
      echo "$run/evidence/$name-$id.png ($w x $h at $x,$y layer $layer ${title:-})"; n=$((n + 1))
    done < <(swift "$here/windows.swift" "$pid")
    [ "$n" -gt 0 ] || echo "no Slotbar window on screen (Panel hidden?)" ;;

  shells)
    # Login shells are direct children of the app. macOS hides another process's environment from ps:
    # prove TERM by typing `echo $TERM` in the tab.
    run="$(run_dir)"; pid="$(pid_of "$run")"
    for child in $(pgrep -P "$pid" || true); do
      echo "pid=$child argv=$(ps -o command= -p "$child") tty=$(ps -o tty= -p "$child")" \
        "cwd=$(lsof -a -d cwd -p "$child" -Fn 2>/dev/null | sed -n 's/^n//p')"
    done ;;

  settings)
    cat "$(settings_of "$(run_dir)")" ;;

  logs)
    run="$(run_dir)"; save_logs "$run"; cat "$run/evidence/app.log" ;;

  stop)
    run="$(run_dir)"
    save_logs "$run"
    stop_app "$run"
    cp "$(settings_of "$run")" "$run/evidence/settings.json" 2>/dev/null || true
    rm -rf "$run/home" "$current"
    echo "stopped; evidence kept in $run/evidence" ;;

  help|*)
    sed -n '/^  [a-z|]*)$/p' "$0" | tr -d ' )' ;;
esac
